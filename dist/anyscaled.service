[Unit]
Description=Anyscale multi-tailnet daemon
Documentation=https://github.com/GabriWar/anyscale
Wants=network-online.target
After=network-online.target
# anyscaled and tailscaled fight over routes and DNS.
Conflicts=tailscaled.service tailmixd.service

[Service]
Type=simple
# Members of the operator group can change tailnets without a password.
# Change it with systemctl edit anyscaled.
Environment="ANYSCALED_FLAGS=-operator-group=wheel"
ExecStart=@BINDIR@/anyscaled -state=/var/lib/anyscale/state.json -socket-dir=/var/run/anyscale $ANYSCALED_FLAGS
Restart=on-failure
RestartSec=5s
StateDirectory=anyscale
StateDirectoryMode=0700
RuntimeDirectory=anyscale
RuntimeDirectoryMode=0755

[Install]
WantedBy=multi-user.target
